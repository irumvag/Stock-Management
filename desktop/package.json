{
  "name": "club-tmp-stock-desktop",
  "version": "2.1.0",
  "description": "Club TMP Stock Manager — Desktop App",
  "main": "main.js",
  "private": true,
  "author": "Club TMP",
  "repository": {
    "type": "git",
    "url": "https://github.com/irumvag/Stock-Management"
  },
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64 --publish never",
    "build:mac": "electron-builder --mac --publish never"
  },
  "build": {
    "appId": "com.clubtmp.stockmanager",
    "productName": "Club TMP Stock Manager",
    "copyright": "Club TMP",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "shortcutName": "Club TMP Stock Manager"
    },
    "mac": {
      "target": "dmg",
      "icon": "build/icon.icns"
    },
    "files": [
      "main.js",
      "preload.js"
    ]
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  }
}
